import Slide16Closing from '../components/slides/Slide16Closing.svelte';
---

<PresentationLayout title="Harness Engineering — Codigo Sin Siesta">
  <Navigation client:load>
    <Slide01Hero client:load />
    <Slide02TheGap client:load />
    <Slide03Caballo client:load />
    <Slide04AgentEquation client:load />
    <Slide05FivePatterns client:load />
    <Slide06BeforeTheChaos client:load />
    <Slide07NLAH client:load />
    <Slide08RepresentationJump client:load />
    <Slide09AblationSurprise client:load />
    <Slide10MetaHarness client:load />
    <Slide11Transferability client:load />
    <Slide12ThreeEras client:load />
    <Slide13Subtraction client:load />
    <Slide14MinimumHarness client:load />
    <Slide15Conclusions client:load />
    <Slide16Closing client:load />
