---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Slide01Hero from '../components/slides/Slide01Hero.svelte';
import Slide02TheGap from '../components/slides/Slide02TheGap.svelte';
import Slide03AgentEquation from '../components/slides/Slide03AgentEquation.svelte';
import Slide04FivePatterns from '../components/slides/Slide04FivePatterns.svelte';
import Slide05BeforeTheChaos from '../components/slides/Slide05BeforeTheChaos.svelte';
import Slide06NLAH from '../components/slides/Slide06NLAH.svelte';
import Slide07RepresentationJump from '../components/slides/Slide07RepresentationJump.svelte';
import Slide08AblationSurprise from '../components/slides/Slide08AblationSurprise.svelte';
import Slide09MetaHarness from '../components/slides/Slide09MetaHarness.svelte';
import Slide10Transferability from '../components/slides/Slide10Transferability.svelte';
import Slide11ThreeEras from '../components/slides/Slide11ThreeEras.svelte';
import Slide12Subtraction from '../components/slides/Slide12Subtraction.svelte';
import Slide13Conclusions from '../components/slides/Slide13Conclusions.svelte';
import Slide14Closing from '../components/slides/Slide14Closing.svelte';
---

<PresentationLayout title="Harness Engineering — Codigo Sin Siesta">
  <Navigation client:load>
    <Slide01Hero client:load />
    <Slide02TheGap client:load />
    <Slide03AgentEquation client:load />
    <Slide04FivePatterns client:load />
    <Slide05BeforeTheChaos client:load />
    <Slide06NLAH client:load />
    <Slide07RepresentationJump client:load />
    <Slide08AblationSurprise client:load />
    <Slide09MetaHarness client:load />
    <Slide10Transferability client:load />
    <Slide11ThreeEras client:load />
    <Slide12Subtraction client:load />
    <Slide13Conclusions client:load />
    <Slide14Closing client:load />
  </Navigation>
</PresentationLayout>
