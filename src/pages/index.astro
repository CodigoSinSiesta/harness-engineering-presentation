---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Slide01Hero from '../components/slides/Slide01Hero.svelte';
import Slide02TheGap from '../components/slides/Slide02TheGap.svelte';
import Slide03Caballo from '../components/slides/Slide03Caballo.svelte';
import Slide04AgentEquation from '../components/slides/Slide04AgentEquation.svelte';
import Slide05Timeline from '../components/slides/Slide05Timeline.svelte';
import Slide06FivePatterns from '../components/slides/Slide06FivePatterns.svelte';
import Slide07BeforeTheChaos from '../components/slides/Slide07BeforeTheChaos.svelte';
import Slide08NLAH from '../components/slides/Slide08NLAH.svelte';
import Slide09RepresentationJump from '../components/slides/Slide09RepresentationJump.svelte';
import Slide10AblationSurprise from '../components/slides/Slide10AblationSurprise.svelte';
import Slide11MetaHarness from '../components/slides/Slide11MetaHarness.svelte';
import Slide12Transferability from '../components/slides/Slide12Transferability.svelte';
import Slide13ThreeEras from '../components/slides/Slide13ThreeEras.svelte';
import Slide14Subtraction from '../components/slides/Slide14Subtraction.svelte';
import Slide15MinimumHarness from '../components/slides/Slide15MinimumHarness.svelte';
import Slide16Conclusions from '../components/slides/Slide16Conclusions.svelte';
import Slide17Closing from '../components/slides/Slide17Closing.svelte';
---

<PresentationLayout title="Harness Engineering — Codigo Sin Siesta">
  <Navigation client:load>
    <Slide01Hero client:load />
    <Slide02TheGap client:load />
    <Slide03Caballo client:load />
    <Slide04AgentEquation client:load />
    <Slide05Timeline client:load />
    <Slide06FivePatterns client:load />
    <Slide07BeforeTheChaos client:load />
    <Slide08NLAH client:load />
    <Slide09RepresentationJump client:load />
    <Slide10AblationSurprise client:load />
    <Slide11MetaHarness client:load />
    <Slide12Transferability client:load />
    <Slide13ThreeEras client:load />
    <Slide14Subtraction client:load />
    <Slide15MinimumHarness client:load />
    <Slide16Conclusions client:load />
    <Slide17Closing client:load />
