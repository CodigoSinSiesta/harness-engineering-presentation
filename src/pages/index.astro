---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Slide01Hero from '../components/slides/Slide01Hero.svelte';
import Slide02TheGap from '../components/slides/Slide02TheGap.svelte';
import Slide03Caballo from '../components/slides/Slide03Caballo.svelte';
import Slide04AgentEquation from '../components/slides/Slide04AgentEquation.svelte';
import Slide05FivePatterns from '../components/slides/Slide05FivePatterns.svelte';
import Slide06BeforeTheChaos from '../components/slides/Slide06BeforeTheChaos.svelte';
import Slide07NLAH from '../components/slides/Slide07NLAH.svelte';
import Slide08RepresentationJump from '../components/slides/Slide08RepresentationJump.svelte';
import Slide09AblationSurprise from '../components/slides/Slide09AblationSurprise.svelte';
import Slide10MetaHarness from '../components/slides/Slide10MetaHarness.svelte';
import Slide11Transferability from '../components/slides/Slide11Transferability.svelte';
import Slide12ThreeEras from '../components/slides/Slide12ThreeEras.svelte';
import Slide13Subtraction from '../components/slides/Slide13Subtraction.svelte';
import Slide14MinimumHarness from '../components/slides/Slide14MinimumHarness.svelte';
